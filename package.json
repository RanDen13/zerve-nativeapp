{
  "name": "zerve-nativeapp",
  "productName": "Zerve Kiosk",
  "version": "1.0.0",
  "description": "Zerve Kiosk Native App",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package:linux": "electron-forge package --platform=linux --arch=x64",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "make:linux": "pnpm run make:linux:deb && pnpm run make:linux:appimage",
    "make:linux:deb": "electron-forge make --platform=linux --arch=x64 --targets=@electron-forge/maker-deb",
    "make:linux:appimage": "pnpm run package:linux && electron-installer-appimage --src \"out/Zerve Kiosk-linux-x64\" --dest out/make --arch x64",
    "make:linux:rpm": "electron-forge make --platform=linux --arch=x64 --targets=@electron-forge/maker-rpm",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": {
    "name": "John Christian D. Rosuelo",
    "email": "152044019+AetherKnowledge@users.noreply.github.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "41.5.0",
    "electron-installer-appimage": "^1.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "motion": "^12.23.26",
    "typescript": "^5.9.3",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.14.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0"
  }
}
